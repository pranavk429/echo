# Echo Game — Environment Variables
# Copy this to .env and fill in real values.

# Cognee Cloud — get these from https://cloud.cognee.ai
COGNEE_BASE_URL=https://api.cognee.ai
COGNEE_API_KEY=your_cognee_api_key_here

# LLM — Cognee uses Gemini by default in this project
# Get a Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
