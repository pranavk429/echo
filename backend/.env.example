# Cognee Cloud — get your credentials from platform.cognee.ai
COGNEE_BASE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=your-api-key

# LLM provider — supports OpenAI, Google Gemini (via LiteLLM)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# Set to "true" to skip the LLM connection test (prevents timeout on first call)
COGNEE_SKIP_CONNECTION_TEST=false
